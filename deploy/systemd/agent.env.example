AI_INFRA_AGENT_ENVIRONMENT=production
AI_INFRA_AGENT_CENTRAL_URL=https://infra.example.com
AI_INFRA_AGENT_TOKEN=replace-with-one-time-registration-token
AI_INFRA_AGENT_HEARTBEAT_SECONDS=10
AI_INFRA_AGENT_REQUEST_TIMEOUT_SECONDS=10
AI_INFRA_AGENT_TLS_VERIFY=true
AI_INFRA_AGENT_LOG_LEVEL=INFO

# JSON array of local, read-only roots this Agent is permitted to scan.
AI_INFRA_AGENT_ALLOWED_MODEL_DIRECTORIES=["/data/models"]
AI_INFRA_AGENT_DEFAULT_MODEL_DIRECTORY=/data/models
AI_INFRA_AGENT_MODEL_SCAN_INTERVAL_SECONDS=300
AI_INFRA_AGENT_MODEL_SCAN_MAX_DEPTH=6
AI_INFRA_AGENT_MODEL_SCAN_MAX_INSTALLATIONS=2000
AI_INFRA_AGENT_MODEL_METADATA_MAX_BYTES=1048576
AI_INFRA_AGENT_OLLAMA_TIMEOUT_SECONDS=2

# Enable only on servers that are also present in Central's mutable-server allowlist.
AI_INFRA_AGENT_ENABLE_MODEL_MUTATIONS=false
AI_INFRA_AGENT_MODEL_TASK_PROGRESS_SECONDS=2
AI_INFRA_AGENT_MODEL_DOWNLOAD_MAX_WORKERS=4

# Deployment control stays opt-in. Pin the exact reviewed image digest before enabling it.
AI_INFRA_AGENT_ENABLE_DEPLOYMENTS=false
AI_INFRA_AGENT_VLLM_IMAGE=vllm/vllm-openai@sha256:replace-with-reviewed-image-digest
AI_INFRA_AGENT_DEPLOYMENT_OPERATION_PROGRESS_SECONDS=5
AI_INFRA_AGENT_DEPLOYMENT_RECONCILE_SECONDS=5
AI_INFRA_AGENT_DEPLOYMENT_STOP_TIMEOUT_SECONDS=20
AI_INFRA_AGENT_DEPLOYMENT_HEALTH_TIMEOUT_SECONDS=2
AI_INFRA_AGENT_DEPLOYMENT_LOG_MAX_LINES=200
AI_INFRA_AGENT_DEPLOYMENT_LOG_MAX_BYTES=262144
AI_INFRA_AGENT_DEPLOYMENT_RUNTIME_FIXTURE=false
AI_INFRA_AGENT_DEPLOYMENT_GPU_FIXTURE=false

# Provider credentials and proxy values are local Agent secrets. Never commit real values.
AI_INFRA_AGENT_HF_TOKEN=
AI_INFRA_AGENT_HF_ENDPOINT=https://huggingface.co
AI_INFRA_AGENT_MODELSCOPE_TOKEN=
AI_INFRA_AGENT_MODELSCOPE_ENDPOINT=https://modelscope.cn
AI_INFRA_AGENT_HTTP_PROXY=
AI_INFRA_AGENT_HTTPS_PROXY=

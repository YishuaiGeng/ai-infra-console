[Unit]
Description=AI Infra Console Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-infra-agent
Group=ai-infra-agent
EnvironmentFile=/etc/ai-infra-console/agent.env
ExecStart=/opt/ai-infra-agent/bin/ai-infra-agent run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=-/data -/mnt -/home/share
# Add explicit ReadWritePaths entries for model roots only when mutations are enabled.
# Example: ReadWritePaths=/data/models

[Install]
WantedBy=multi-user.target

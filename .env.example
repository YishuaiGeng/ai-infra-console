# Runtime mode: use production on xiao-pro6000.
AI_INFRA_ENVIRONMENT=development

# Generate independent strong values before production deployment.
AI_INFRA_JWT_SECRET=replace-with-at-least-32-random-characters
AI_INFRA_BOOTSTRAP_ADMIN_USERNAME=admin
AI_INFRA_BOOTSTRAP_ADMIN_PASSWORD=replace-before-production
AI_INFRA_POSTGRES_PASSWORD=replace-before-production

# Optional host port overrides.
AI_INFRA_WEB_PORT=3000
AI_INFRA_API_PORT=8000

# Server-side URL used by the Next.js Web container. The Compose default is http://api:8000.
AI_INFRA_API_INTERNAL_URL=http://127.0.0.1:8000

# Application tuning.
AI_INFRA_ACCESS_TOKEN_MINUTES=30
AI_INFRA_AGENT_OFFLINE_SECONDS=30
AI_INFRA_LOG_LEVEL=INFO

# Model catalog credentials stay local to Central. Leave tokens empty for public models.
AI_INFRA_HF_TOKEN=
AI_INFRA_HF_ENDPOINT=https://huggingface.co
AI_INFRA_MODELSCOPE_TOKEN=
AI_INFRA_MODELSCOPE_ENDPOINT=https://modelscope.cn
AI_INFRA_MODEL_CATALOG_TIMEOUT_SECONDS=10
AI_INFRA_MODEL_CATALOG_CACHE_SECONDS=60

# JSON array of the only servers Central may ask to change.
# The planned production boundary is xiao-pro6000 plus xiao-cpu; backup ASUS hosts stay absent.
AI_INFRA_MUTABLE_SERVER_NAMES=["xiao-pro6000","xiao-cpu"]
AI_INFRA_MODEL_TASK_LEASE_SECONDS=60
AI_INFRA_DEPLOYMENT_TASK_LEASE_SECONDS=90
AI_INFRA_DEPLOYMENT_TELEMETRY_FRESH_SECONDS=30
AI_INFRA_DEPLOYMENT_LOG_RETENTION_LINES=2000
AI_INFRA_VLLM_IMAGE=vllm/vllm-openai:latest
